NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Used by scripts/watch-deploy.mjs to poll the Cloudflare Pages API for a
# deployment's build status/logs after a push. Optional — everything it
# would report, the pre-push gate (scripts/pre-push-gate.mjs) already
# catches first, locally, before the push happens.
#
# Create at https://dash.cloudflare.com/profile/api-tokens
# Token permission needed: Account > Cloudflare Pages > Read
# See demo/scripts/DEPLOY-GATE.md for the full setup.
CLOUDFLARE_API_TOKEN=
